{
  "name": "scan-ktm-backend",
  "version": "1.0.0",
  "description": "Backend REST API for STNK Check UAD with Express.js and Supabase",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "db:migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:clear": "node src/db/clear.js",
    "seed:clean": "node src/db/clear.js",
    "seed:reset": "node src/db/clear.js && node src/db/seed.js",
    "db:clear": "node src/db/clear.js"
  },
  "keywords": [
    "express",
    "supabase",
    "stnk-check",
    "ktm-scanner",
    "uad"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
